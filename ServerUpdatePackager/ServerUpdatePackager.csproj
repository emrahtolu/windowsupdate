<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>Server-Update-Packager-v2</AssemblyName>
    <RootNamespace>ServerUpdatePackager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <Authors>emrahtolu</Authors>
    <Product>Server Update Packager</Product>
    <Description>Microsoft Update Catalog paketlerini indirir ve PowerShell kurulum betiği üretir. Geliştiren: @emrahtolu</Description>
  </PropertyGroup>
</Project>
